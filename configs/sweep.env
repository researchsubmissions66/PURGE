# Defaults for the SLURM launchers. Override by exporting these before running
# scripts/launch_*.sh, or by sourcing this file:
#
#   set -a; source configs/sweep.env; set +a
#   bash scripts/launch_erasers.sh

# Paths
PURGE_BASE_DIR=/work/hdd/bhwm
PURGE_OUTPUT_DIR=results/sweep
PURGE_METADATA=data/multi_benchmark_metadata.csv

# SLURM
PURGE_SLURM_ACCOUNT=bhwm-delta-gpu
# Comma-separated; Slurm takes whichever frees first. Check contention with:
#   squeue -h -o "%P %t" | sort | uniq -c | sort -rn | head
PURGE_SLURM_PARTITION=gpuA40x4,gpuA100x4
# Shortest queue, but jobs can be killed and requeued:
#   PURGE_SLURM_PARTITION=gpuA40x4-preempt,gpuA40x4,gpuA100x4
PURGE_SLURM_MEM=64G
PURGE_SLURM_CPUS=8
PURGE_MODULE_CMD="module load pytorch-conda"

# Sweep shape (see the launcher scripts for the full list)
#   NUM_FOLDS   folds to run                      (baselines default 5, erasers 1)
#   RANK        dimensions the eraser annihilates (default 64)
#   EPOCHS      training epochs                   (default 15)
#   ERASER_FMS  bash array of encoders for the eraser/eval sweeps
